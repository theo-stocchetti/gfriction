{
  "description": "Codex friction logging hooks",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.ts"
          }
        ]
      }

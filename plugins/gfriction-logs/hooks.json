{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ./scripts/post-tool-use.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ./scripts/stop.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
